{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Miku Desktop",
  "version": "0.1.7",
  "identifier": "com.cxmluwu.mikuui",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Miku Desktop",
        "width": 800,
        "height": 400,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "shadow": false,
        "focus": true,
        "skipTaskbar": true
      },
      {
        "label": "settings",
        "title": "Configuración · Miku v0.1.7 Beta",
        "url": "miku_settings.html",
        "width": 1080,
        "height": 780,
        "resizable": false,
        "minWidth": 760,
        "visible": false,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": false
      },
      {
        "label": "link",
        "title": "Miku-Link · Enlace Móvil",
        "url": "miku_link.html",
        "width": 460,
        "height": 700,
        "resizable": false,
        "visible": false,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/miku-core"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "headerImage": "installer_header.bmp",
        "sidebarImage": "installer_sidebar.bmp",
        "installerIcon": "icons/installer_icon.ico",
        "installerHooks": "hooks.nsi"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE2NkFFNUVCNDFENjE1NzUKUldSMUZkWkI2K1ZxcHB5WTVJM3NsWmp4b1F0ZXc2bU9SUFJ0b0laREExZk5rREh4NDZCblcxV0YK",
      "endpoints": [
        "https://github.com/cxmlo/miku/releases/latest/download/latest.json"
      ]
    }
  }
}
