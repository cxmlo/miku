# Claves de API para Miku Desktop
# Admite múltiples claves por proveedor separadas por coma para rotación automática de respaldo
GEMINI_API_KEY=tu_clave_gemini_aqui
GROQ_API_KEY=tu_clave_groq_aqui
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
NVIDIA_API_KEY=

# Google Cloud / Vertex AI (opcional)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Síntesis de voz realista (opcional)
ELEVENLABS_API_KEY=

# Detección y activación por voz
WAKE_WORD=miku

# Spotify Web API (opcional, para búsqueda avanzada)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8888/callback
